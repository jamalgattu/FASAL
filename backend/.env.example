# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql+psycopg2://fasal:fasal@localhost:5432/fasal
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,https://jamalgattu.github.io

# Matching engine weights — must sum to 1.0 (auto-normalized if they don't)
MATCH_WEIGHT_PRICE=0.25
MATCH_WEIGHT_DISTANCE=0.20
MATCH_WEIGHT_QUALITY=0.20
MATCH_WEIGHT_AVAILABILITY=0.20
MATCH_WEIGHT_RELIABILITY=0.15
MATCH_MAX_DISTANCE_KM=300
